<div id="levels" class="levels-container">
  <div class="flavour point-div">
    <p class="point-label">FLAVOUR</p>
    <div id="flavour-points" class="points">
      {% assign level = flavour %}
      {% assign isFlavourPointHalf = isFlavourPointHalf %}

      {% for i in (1..5) %}
        {% if i <= level %}
          {% if isFlavourPointHalf == true and i == level %}
            <div class="level-box half-filled"></div>
          {% else %}
            <div class="level-box filled"></div>
          {% endif %}
        {% else %}
          <div class="level-box"></div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="sweetness point-div">
    <p class="point-label">SWEETNESS</p>

    <div id="sweetness-points" class="points">
      {% assign level = sweetness %}
      {% assign isSweetnessPointHalf = isSweetnessPointHalf %}

      {% for i in (1..5) %}
        {% if i <= level %}
          {% if isSweetnessPointHalf == true and i == level %}
            <div class="level-box half-filled"></div>
          {% else %}
            <div class="level-box filled"></div>
          {% endif %}
        {% else %}
          <div class="level-box"></div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="icyness point-div">
    <p class="point-label">ICINESS</p>

    {% if isIcynessAdjustable == true %}
      <div class="isIcynessAdjustable">
        <div class="leftBar"></div>
        <div class="centerCircle"></div>
        <div class="rightBar"></div>
      </div>
    {% else %}
      <div id="icyness-points" class="points">
        {% assign level = icyness %}
        {% assign isIcynessPointHalf = isIcynessPointHalf %}

        {% for i in (1..5) %}
          {% if i <= level %}
            {% if isIcynessPointHalf == true and i == level %}
              <div class="level-box half-filled"></div>
            {% else %}
              <div class="level-box filled"></div>
            {% endif %}
          {% else %}
            <div class="level-box"></div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .half-filled{
    background: linear-gradient(to right,#fff 50%, #000 50%)
  }

  div:empty{
    display:block;
  }
  .isIcynessAdjustable{
    width:100px;
    display: flex;
    align-items:center;
  }
  .centerCircle {
    width: 24px;
    height: 12px;
    background-color: #fff;
    border-radius: 50%;
    border: 1px solid #fff;
  }
  .leftBar{
    width: 100%;
    height: 8px;
    background-color: #fff;
    border: 1px solid #000;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
    position: relative;
    right: -1px;
  }
  .rightBar{
    width: 100%;
    height: 6px;
    background-color: #000;
    border: 1px solid #fff;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left: none;
    position: relative;
    left: 0px;
  }
</style>
