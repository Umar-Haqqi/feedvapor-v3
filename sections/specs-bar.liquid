{%- comment -%}
  Specs Bar
  ---------
  A row of circular icon badges highlighting a collection's key specs
  (e.g. "120K Puff Count", "4 Mesh Coil"...). Reusable across any template.

  Each block can use either:
    - an uploaded icon image (block setting "icon_image"), or
    - a RemixIcon class as a placeholder (block setting "icon_class") — the
      theme already loads RemixIcon globally, so this needs no new assets.
  Uploading an icon image always takes priority over the icon_class fallback,
  so swapping in real icons later is just: block > upload icon image.
{%- endcomment -%}

{{ 'specs-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .specs-bar {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .spec-icon {
    color: {{ section.settings.icon_color }};
    border-color: {{ section.settings.icon_color }};
  }
  #shopify-section-{{ section.id }} .spec-label {
    color: {{ section.settings.text_color }};
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="specs-bar">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="specs-bar-heading" style="color: {{ section.settings.text_color }};">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      <ul class="specs-bar-grid">
        {%- for block in section.blocks -%}
          <li class="spec-item" {{ block.shopify_attributes }}>
            <div class="spec-icon">
              {%- if block.settings.icon_image != blank -%}
                {{
                  block.settings.icon_image
                  | image_url: width: 100
                  | image_tag: loading: 'lazy', widths: '50,100', sizes: '50px'
                }}
              {%- elsif block.settings.icon_class != blank -%}
                <i class="{{ block.settings.icon_class }}" aria-hidden="true"></i>
              {%- else -%}
                <span class="spec-icon-placeholder" aria-hidden="true"></span>
              {%- endif -%}
            </div>
            <p class="spec-label">{{ block.settings.label }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Specs Bar",
  "tag": "section",
  "class": "section specs-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0D0D0D"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon / circle color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Spec label",
          "default": "Spec label"
        },
        {
          "type": "text",
          "id": "icon_class",
          "label": "Placeholder icon (RemixIcon class)",
          "info": "Used until you upload a real icon below. Browse icons at remixicon.com — e.g. ri-cloud-line",
          "default": "ri-checkbox-circle-line"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (optional)",
          "info": "Upload your real icon here to replace the placeholder above."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Specs Bar",
      "blocks": [
        { "type": "spec", "settings": { "label": "120K Puff Count", "icon_class": "ri-cloud-line" } },
        { "type": "spec", "settings": { "label": "4 Mesh Coil", "icon_class": "ri-loader-4-line" } },
        { "type": "spec", "settings": { "label": "30 mL E-Liquid", "icon_class": "ri-drop-line" } },
        { "type": "spec", "settings": { "label": "Adjustable Airflow", "icon_class": "ri-settings-3-line" } },
        {
          "type": "spec",
          "settings": { "label": "E-Liquid & Battery Indicator", "icon_class": "ri-battery-2-charge-line" }
        }
      ]
    }
  ]
}
{% endschema %}
