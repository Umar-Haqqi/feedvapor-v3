        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#ffffff"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button background color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "footer_text",
          "label": "Footer text",
          "default": "BUY 5 GET 1 FREE"
        },
        {
          "type": "text",
          "id": "footer_highlight_text",
          "label": "Footer highlighted text",
          "default": "| MIX AND MATCH FLAVOURS"
        },
        {
          "type": "color",
          "id": "footer_text_color",
          "label": "Footer text color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "footer_highlight_color",
          "label": "Footer highlight color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card background color"
        },
        {
          "type": "color",
          "id": "footer_bg_color",
          "label": "Footer background color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CustomCollectionGridCard",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "PODS-SYSTEMS",
            "title_color": "#ffffff",
            "button_text": "Shop now",
            "button_link": "/collections/vape-pods-in-canada",
            "button_bg_color": "#ffffff",
            "button_text_color": "#000000",
            "footer_text": "BUY 5 GET 1 FREE",
            "footer_highlight_text": "| MIX AND MATCH FLAVOURS",
            "footer_text_color": "#ffffff",
            "footer_highlight_color": "#ffffff",
            "footer_bg_color": "#ffffff"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "DISPO--SABLES",
            "title_color": "#000000",
            "button_text": "Shop now",
            "button_link": "/collections/feed-freezie-disposable-pods",
            "button_bg_color": "#000000",
            "button_text_color": "#ffffff",
            "footer_text": "BUY 5 GET 1 FREE",
            "footer_highlight_text": "| MIX AND MATCH FLAVOURS",
            "footer_text_color": "#000000",
            "footer_highlight_color": "#000000",
            "footer_bg_color": "#ffffff"
          }
        }
