<script>
  document.addEventListener('DOMContentLoaded', function () {
    var savedProvince = localStorage.getItem('userProvince');
  
    // Select both province selectors by their class name
    const provinceSelectors = document.querySelectorAll('.provinceSelector');
  
    // If a saved province exists, set it for all province selectors
    if (savedProvince) {
      provinceSelectors.forEach((select) => {
        select.value = savedProvince;
      });
    }
  
    // Function to update the province in localStorage and sync all selectors
    function updateProvince(selectedProvince) {
      localStorage.setItem('userProvince', selectedProvince);
      console.log("Province stored in localStorage:", localStorage.getItem('userProvince'));
  
      // Update all province selectors to keep them in sync
      provinceSelectors.forEach((select) => {
        select.value = selectedProvince;
      });
    }
  
    // Attach event listeners to both province selectors
    provinceSelectors.forEach((select) => {
      select.addEventListener('change', async function () {
        var selectedProvince = this.value;
        updateProvince(selectedProvince);
        await emptyCart();
        location.reload();
      });
    });

    provinceSelectors.forEach((select) => {
  select.addEventListener('change', async function () {
    var selectedProvince = this.value;

    updateProvince(selectedProvince);

    // Clear cart
    await emptyCart();

    // Provinces requiring age verification
    if (selectedProvince === 'QC' || selectedProvince === 'NS') {

      // Remove existing age verification cookie if needed
      document.cookie =
        "visitor=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

      // Show age gate
      document.body.classList.add("age-verification-lock");

      const ageGate = document.querySelector(".age-verification-section");

      if (ageGate) {
        ageGate.style.display = "flex";
      }

    } else {
      // Other provinces
      location.reload();
    }
  });
});
  
    // Update the header province when "Yes, I am over 21" is clicked on age verification
    document.getElementById('yess').addEventListener('click', function () {
      var selectedProvince = localStorage.getItem('userProvince');
      if (selectedProvince) {
        // Update all province selectors to match the saved province
        provinceSelectors.forEach((select) => {
          select.value = selectedProvince;
        });
      }
    });
  });
  
  // Function to empty the Shopify cart
  async function emptyCart() {
    try {
      const response = await fetch('/cart/clear.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
      });
  
      if (response.ok) {
        console.log("Cart cleared successfully");
      } else {
        console.error("Failed to clear the cart");
      }
    } catch (error) {
      console.error("Error clearing the cart:", error);
    }
  }

</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

