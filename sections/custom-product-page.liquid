<script>

  console.log("tttttttttt", {{ product.featured_image | json }});


const productName = document.querySelector('.product-heading');
const productPrice = document.querySelector('.product-price');
             
  
content.forEach((item, index) => {
  if (index === 0) {

    
    // const BR = item.lineBreak;
    // const splitPodHeading = item.podTitle.split(" ");

    // if (BR > 0 && BR <= splitPodHeading.length) {
    //   splitPodHeading.splice(BR, 0, "<br />");
    // }
    
    // productName.innerHTML = splitPodHeading.toString().replace(/,/g, " ");
    // productPrice.innerHTML = item.productPrice;

    
    // +++++++++ flavour level +++++++++
        levels.innerHTML = `
          <div class="flavour point-div">
              <p class="point-label">FLAVOUR</p>
              <div id="flavour-points" class="points">
                  ${createBoxes(item.level.flavour)}
              </div>
          </div>
          <div class="sweetness point-div">
              <p class="point-label">SWEETNESS</p>
              <div id="sweetness-points" class="points">
                  ${createBoxes(item.level.sweetness)}
              </div>
          </div>
          <div class="icyness point-div">
              <p class="point-label">ICYNESS</p>
              <div id="icyness-points" class="points">
                  ${createBoxes(item.level.icyness)}
              </div>
          </div>
        `;

    function createBoxes(level) {
      let boxesHTML = "";
      for (let i = 0; i < 5; i++) {
        if (i < level) {
          boxesHTML += `<div class="level-box filled"></div>`;
        } else {
          boxesHTML += `<div class="level-box"></div>`;
        }
      }
      return boxesHTML;
    }

    
    // +++++++++ inc dec +++++++++
    let incrementButtons = document.querySelectorAll('#inc_btn');
    let decrementButtons = document.querySelectorAll('#dec_btn');

    incrementButtons.forEach(function(button) {
      button.addEventListener('click', function() {
          let productId = this.id.replace('increment-', '');
          let quantityDisplay = document.querySelector(`#quantityDisplay`);
          let currentQuantity = parseInt(quantityDisplay.innerText);
          quantityDisplay.innerText = currentQuantity + 1;
      });
    });

    
    // +++++++++ changing image +++++++++
    decrementButtons.forEach(function(button) {
      button.addEventListener('click', function() {
          let productId = this.id.replace('decrement-', '');
          let quantityDisplay = document.querySelector(`#quantityDisplay`);
          let currentQuantity = parseInt(quantityDisplay.innerText);
          if (currentQuantity > 1) {
              quantityDisplay.innerText = currentQuantity - 1;
          }
      });
    });

    document.addEventListener("DOMContentLoaded", function() {
    const addToCartButton = document.querySelector('.add-to-cart-btn');
    const popupCard = document.getElementById('popup-card');

    addToCartButton.addEventListener('click', function() {
          popupCard.classList.add('show');
        
          setTimeout(function() {
              popupCard.classList.remove('show');
          }, 3000);
      });
    });
  }    
})

    document.addEventListener("DOMContentLoaded", function() {
      const thumbnailImages = document.querySelectorAll('.product-thumbnail-img');
      const mainImage = document.querySelector('.product-item-img');
      
      thumbnailImages.forEach((thumbnail,index)=> {
          thumbnail.addEventListener('click', function() {          
              mainImage.src = thumbnail.src;
          });
      });        
    });
</script>

