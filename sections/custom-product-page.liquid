<section class="product-page-section">
  <div class="breadcrumbs">
    <!-- <p class="collection-name"> -->
    <a class="collection-name" href="{{ product.collections[0].url }}">{{ product.collections[0].handle }}</a>
    <!-- </p> -->

    <i class="ri-arrow-right-s-line"></i>
    <p class="product-name">{{ product.handle }}</p>
    <p></p>
  </div>

  <div class="product-page-container">
    <div class="product-images">
      <div class="main-image" style="background-color: {{ product.metafields.custom.background_colour }}">
        <img
          class="product-item-img"
          src="{{ product.featured_image | img_url: '900x900' }}"

          sizes="(max-width: 900px) 100vw, 900px"
          alt="{{ product_title | escape }}"
          width="900"
          height="900"
        >
        {% if product.metafields.custom.tagline_image %}
          <img
            class="tagline-img"
            src="{{ product.metafields.custom.tagline_image | img_url: '900x900' }}"
            srcset="
              {{ product.metafields.custom.tagline_image | img_url: '300x300' }} 300w,
              {{ product.metafields.custom.tagline_image | img_url: '600x600' }} 600w,
              {{ product.metafields.custom.tagline_image | img_url: '900x900' }} 900w
            "
            sizes="(max-width: 900px) 100vw, 900px"
            alt="{{ product_title | escape }}"
            width="900"
            height="900"
          >
        {% endif %}
      </div>

      <div class="thumbnails">
        {% for image in product.images %}
          <div class="thumbnail-div" style="background-color: {{ product.metafields.custom.background_colour }}">
            <img
              class="product-thumbnail-img"
              src="{{ image | img_url: '300x300' }}"
              srcset="
                {{ image | img_url: '300x300' }} 300w,
                {{ image | img_url: '600x600' }} 600w,
                {{ image | img_url: '900x900' }} 900w
              "
              sizes="(max-width: 900px) 100vw, 900px"
              alt=""
              width="auto"
              height="auto"
            >
            {% if product.metafields.custom.tagline_image %}
              <img
                class="tagline-img-thumbnail"
                src="{{ product.metafields.custom.tagline_image | img_url: '300x300'}}"
                srcset="
                  {{ product.metafields.custom.tagline_image | img_url: '300x300' }} 300w,
                  {{ product.metafields.custom.tagline_image | img_url: '600x600' }} 600w,
                  {{ product.metafields.custom.tagline_image | img_url: '900x900' }} 900w
                "
                sizes="(max-width: 900px) 100vw, 900px"
                alt=""
                width="auto"
                height="auto"
              >
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="swiper mySwiper">
      <div class="swiper-wrapper">
        {% for swiperImg in product.images %}
          <div class="swiper-slide" style="background-color: {{ product.metafields.custom.background_colour }}">
            <div class="swiper-image-container">
              <img
                class="swiper-main-image"
                src="{{ swiperImg | img_url: '300x300' }}"
                srcset="
                  {{ swiperImg | img_url: '300x300' }} 300w,
                  {{ swiperImg | img_url: '600x600' }} 600w,
                  {{ swiperImg | img_url: '900x900' }} 900w
                "
                sizes="(max-width: 900px) 100vw, 900px"
                alt=""
                width="auto"
                height="auto"
              >
              {% if product.metafields.custom.tagline_image %}
                <img
                  class="swiper-tagline-img"
                  src="{{ product.metafields.custom.tagline_image | img_url: '300x300'}}"
                  srcset="
                    {{ product.metafields.custom.tagline_image | img_url: '300x300' }} 300w,
                    {{ product.metafields.custom.tagline_image | img_url: '600x600' }} 600w,
                    {{ product.metafields.custom.tagline_image | img_url: '900x900' }} 900w
                  "
                  sizes="(max-width: 900px) 100vw, 900px"
                  alt=""
                  width="auto"
                  height="auto"
                >
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>

    <div class="product-info-actions">
      <h1 class="product-heading">{{ product.title }}</h1>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
      <!-- <h1 class="product-heading"></h1> -->
      <p class="product-details">{{ product.description }}</p>
      <p class="product-price">{{ product.price | money_with_currency }}</p>

      <div id="levels" class="levels-container"></div>

      <div class="svg-product-info">
        <img
          src="https://cdn.shopify.com/s/files/1/0860/7183/6978/files/flavour-profile-footer-svg.svg?v=1711107909"
          alt=""
          width="auto"
          height="auto"
        >
      </div>
      <div class="add-to-card">
        <div class="inc-dec-box">
          <button id="dec_btn"><i class="ri-subtract-fill"></i></button>
          <p id="quantityDisplay">1</p>
          <button id="inc_btn"><i class="ri-add-line"></i></button>
        </div>
        <button class="add-to-cart-btn">Add to Cart</button>

        <div id="popup-card" class="popup-card">
          <div class="popup-header">
            <i class="ri-check-line"></i>
            <p>Added To cart</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

