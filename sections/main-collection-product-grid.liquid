<script>
  const params = new URLSearchParams(window.location.search);

  if (!params.has('page') || params.get('page') === '1') {
    document.querySelector('.collection-page-desc-section').style.display = 'block';
  } else {
    document.querySelector('.collection-page-desc-section').style.display = 'none';
  }
</script>

<script>
  let buttons = document.querySelectorAll('.product-coll-tab-btn');
  let podsBtn = document.querySelector('#pods');
  let pods30kBtn = document.querySelector('#pods-30k');
  let starterKitsBtn = document.querySelector('#starter-kits');
  let batteriesBtn = document.querySelector('#batteries');
  let freezieBtn = document.querySelector('#feed-freezie');
  let feedTankBtn = document.querySelector('#feed-tank');
  let syncBtn = document.querySelector('#feed-sync');

  let pathSegments = window.location.pathname.split('/');
  let collectionName = pathSegments[pathSegments.length - 1]; // gets the last segment of the URL, which basically tells what collection are we on

  // let selectedButton = document.querySelector(`#${collectionName}`)

  // console.log(collectionName," here collectionName")

  if (collectionName === 'vape-pods-in-canada') {
    podsBtn.classList.add('active-product-coll-tab-btn');
  } else if (collectionName === 'pods-30k') {
    pods30kBtn.classList.add('active-product-coll-tab-btn');
  } else if (collectionName === 'vape-starter-kits-canada') {
    starterKitsBtn.classList.add('active-product-coll-tab-btn');
  } else if (collectionName === 'batteries') {
    batteriesBtn.classList.add('active-product-coll-tab-btn');
  } else if (collectionName === 'feed-tank') {
    feedTankBtn.classList.add('active-product-coll-tab-btn');
  } else if (collectionName === 'feed-freezie-disposable-pods') {
    freezieBtn.classList.add('active-product-coll-tab-btn');
  }
  else if (collectionName === 'feed-sync-25k-disposable-vape') {
    syncBtn.classList.add('active-product-coll-tab-btn');
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll('.collection-page-toast').forEach((toast) => {
      const closeBtn = toast.querySelector('.toast-close-btn');

        closeBtn.addEventListener('click', () => {
          toast.classList.add('toast-hide');
          setTimeout(() => toast.remove(), 250);
        });
      });
    });
</script>

