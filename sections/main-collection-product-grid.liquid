                {% elsif collection.handle == block.settings.toast_collection %}
                  {% assign show_block = true %}
                {% endif %}

                {% if show_block %}
                  <div class="collection-page-toast" data-toast-id="{{ block.id }}">
                    <button class="toast-close-btn" aria-label="Close">✕</button>
