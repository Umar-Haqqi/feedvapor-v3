<script>
  const targetDiv = document.getElementById('zoom-effect');

  // Add event listener to detect scroll position
  window.addEventListener('scroll', () => {
      // Get the position of the target div relative to the viewport
      const bounding = targetDiv.getBoundingClientRect();

      // Check if the top of the div is in the viewport
      if (bounding.top >= 0) {
          // Apply zoom effect
          targetDiv.classList.add('zoomed');
          console.log("zoomed");
      } else {
          // Revert back to normal size
          targetDiv.classList.remove('zoomed');
          console.log("zoom out");
      }
  });
</script>

