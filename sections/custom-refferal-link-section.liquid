<style>
    @keyframes slide {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .referal-logos-LTR {
    overflow: hidden;
    padding: 5px 0;
    background: white;
    white-space: nowrap;
    position: relative;
  }

  .referral-slide-LTR {
    display: inline-block;
    animation: 60s slide infinite linear;
  }

  .referral-slide-LTR>.referral-bullet-LTR {
    display: inline-block;
    width: 6px;
    height: 6px;
    background-color: black;
    border-radius: 50%;
    margin: 0px 15px 2px 15px;
  }

  .referral-slide-LTR>.referral-text-LTR {
    display: inline-block;
    font-size: 14px;
    font-family: ArupalaGrotesk-SuperBold;
    color: black;
    text-transform: uppercase;
  }
</style>

