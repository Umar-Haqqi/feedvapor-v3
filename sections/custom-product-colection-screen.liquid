        splitHeading.splice(BR, 0, "<br />");
      }
      const headingWithBr = splitHeading.join(" ");

      productCollectionGridContainer.innerHTML += `
          <div class="product-collection-card">
              <div class="product-image" style="background-color: ${product.backgroundClr}">
                  <img src="${product.image}" alt="">
              </div>
              <div class="info-and-actions">
