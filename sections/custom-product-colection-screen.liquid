<section id="product_collection_list" class="product-collection-list">
  <div class="product-coll-tabs">
    {% for collection in collections %}
      {% assign title_parts = collection.title | split: ' ' %}
      {% if title_parts.size > 1 %}
        {% assign modified_title = title_parts | slice: 1, title_parts.size %}
        {% assign display_title = modified_title | join: ' ' %}
      {% else %}
        {% assign display_title = collection.title %}
      {% endif %}
      <button id="{{ collection.handle }}" class="product-coll-tab-btn" data-collection="{{ collection.handle }}">
        {{ display_title }}
      </button>
    {% endfor %}
  </div>

  <div class="toast" id="toast">
    <div class="toast-header">
      <i class="ri-check-line"></i>
      <p>Added To cart</p>
    </div>
  </div>

  {% for collection in collections %}
    <div
      id="product-collection-grid-container-{{ collection.handle }}"
      class="product-collection-grid-container"
      style="display:none"
    >
      {%- for product in collection.products -%}
        {% assign is_out_of_stock = true %}
        {% for variant in product.variants %}
          {% if variant.available %}
            {% assign is_out_of_stock = false %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% render 'custom-card-product',
          product_id: product.id,
          variant_id: product.variants.first.id,
          is_out_of_stock: is_out_of_stock,
          product_url: product.url,
          product_image: product.featured_image,
          product_title: product.title,
          product_price: product.price,
          product_background_color: product.metafields.custom.background_colour,
          line_break: product.metafields.custom.line_break
        %}
      {%- endfor -%}
    </div>
  {% endfor %}
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {

    //------------------- custom-card-product-increment-decrement ------------------------//
    let incrementButtons = document.querySelectorAll('.inc-btn');
    let decrementButtons = document.querySelectorAll('.dec-btn');
    let addToCartButtons = document.querySelectorAll('.add-to-cart-btn');

    incrementButtons.forEach(function(button) {
      button.addEventListener('click', function() {
          console.log('clicked')
          let productId = this.id.replace('increment-', '');
          let quantityDisplay = document.querySelector(`#quantityDisplay-${productId}`);
          let currentQuantity = parseInt(quantityDisplay.innerText);
          quantityDisplay.innerText = currentQuantity + 1;
      });
    });

    decrementButtons.forEach(function(button) {
      button.addEventListener('click', function() {
          let productId = this.id.replace('decrement-', '');
          let quantityDisplay = document.querySelector(`#quantityDisplay-${productId}`);
          let currentQuantity = parseInt(quantityDisplay.innerText);
          if (currentQuantity > 1) {
              quantityDisplay.innerText = currentQuantity - 1;
          }
      });
    });
    //------------------- custom-card-product-increment-decrement ------------------------//

    //------------------- Add to Cart Functionality --------------------------------------//
    
    addToCartButtons.forEach(function(addToCartButton) {
      addToCartButton.addEventListener('click', function(){
        let productId = this.id.replace('add-to-cart-btn-','');
        let quantityDisplay = document.querySelector(`#quantityDisplay-${productId}`);
        let currentQuantity = parseInt(quantityDisplay.innerText);

        let data = {
           'items': [{
              'id': parseInt(productId),
              'quantity': currentQuantity
            }]
        };
        
        fetch('/cart/add.js', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(data => {
            console.log('Item added:', data);
            // Update the cart UI here
        })
        .catch((error) => {
            console.error('Error:', error);
        });
      })
    });
    
  const showToastBtn = document.querySelectorAll(".add-to-cart-btnnn");
  const toast = document.querySelector('#toast');
  
  showToastBtn.forEach((btn) => {
    btn.addEventListener('click', function() {
      console.log("show toast");
      toast.classList.add('toast-active');
      // btn.textContent = "Added to Cart";
      btn.innerHTML = `
        {%- render 'loading-spinner' -%}
      `;
      
      setTimeout(function() {
        btn.innerHTML="Add to Cart";
        toast.classList.remove('toast-active');
      }, 3000);

    });
  });


    //------------------- Add to Cart Functionality --------------------------------------//
  
    let buttons = document.querySelectorAll('.product-coll-tab-btn');
  
    let pathSegments = window.location.pathname.split('/');
    let collectionName = pathSegments[pathSegments.length - 1]; // gets the last segment of the URL, which basically tells what collection are we on
    console.log(collectionName)
  
    let selectedButton = document.querySelector(`#${collectionName}`)
    let selectedCollectionDiv = document.getElementById(`product-collection-grid-container-${collectionName}`); 

    console.log(selectedButton)
    console.log(selectedCollectionDiv)
  
    if(selectedButton && selectedCollectionDiv) {
      selectedButton.classList.add('active-tab-btn');
      selectedCollectionDiv.style.display = 'grid';
    } else {
      buttons[0].classList.add('active-tab-btn')
      document.querySelector('.product-collection-grid-container').style.display = 'grid'
      
    } 
    
    buttons.forEach(function(button) {
        button.addEventListener('click', function() {
            // Remove 'active-tab-btn' class from all buttons
            buttons.forEach(btn => btn.classList.remove('active-tab-btn'));
            document.querySelectorAll('.product-collection-grid-container').forEach(div => {
              div.style.display = 'none';
            });

            // Add 'active-tab-btn' class to the clicked button and apply style grid to that collection
            this.classList.add('active-tab-btn');
            document.getElementById(`product-collection-grid-container-${this.id}`).style.display = 'grid';
        });
    });
});
</script>

