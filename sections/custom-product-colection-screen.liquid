  <style>
       .product-collection-list {
        width: 100%;
        height: auto;
        background: #000;
        color: #fff;
        padding: 3% 5%;
    }

    .product-coll-tabs {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        margin-bottom: 3rem;
    }

    .product-coll-tab-btn {
        background: #000;
        color: #fff;
        font: 0.6rem;
        padding: 0.4rem 0.8rem;
        border: 1px solid #fff;
        border-radius: 20px;
        cursor: pointer;
        font-family: "Helvetica", Arial, sans-serif;
    }

    .active-tab-btn {
        background: #fff;
        color: #000;
        font-weight: bold;
    }

    .product-collection-grid-container {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 2rem;
    }

    .product-collection-card {
        height: 420px;
        min-width: 200px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #252525;
        border-radius: 10px;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 250px;
        position: relative;
    }

    .product-image>img {
        position: relative;
        top: -10%;
        left: 3%;
        width: 100%;
        height: 125%;
        object-fit: cover;
        object-position: center;
    }

    .info-and-actions {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1rem;
        height: 170px;
    }

    .info-and-actions>.product-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .product-info>.product-name {
        font-size: 1.7rem;
        font-family: "ArupalaGrotesk-reg";
        font-weight: 600;
        line-height: 20px;
        text-transform: uppercase;
    }

    .product-info>.product-price {
        font-size: 1.2rem;
        font-family: "ArupalaGrotesk-reg";
        font-weight: 600;
    }

    .inc-dec {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .inc-dec>.qty {
        color: #fff;
        text-align: center;
        width: 2rem;
        height: 2rem;
        font-size: 1.2rem;
        margin-bottom: 1rem;
        line-height: 2rem;
        font-family: "Helvetica", Arial, sans-serif;
    }


    .inc-dec>.inc-dec-btn {
        background: #fff;
        color: #000;
        text-align: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        cursor: pointer;
        border: none;
        font-size: 1.2rem;
        margin-bottom: 1rem;
        line-height: 2rem;
        font-weight: 600;
        font-family: "Helvetica", Arial, sans-serif;
    }

    .product-actions .add-to-cart-btn {
        background: transparent;
        padding: 0.5rem;
        color: #fff;
        border: 1px solid #fff;
        border-radius: 20px;
        width: 100%;
        cursor: pointer;
        font-family: "Helvetica", Arial, sans-serif;
    }

    @media only screen and (max-width: 435px) {
        .product-collection-grid-container {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
            gap: 1rem;
        }

        .product-collection-card {
            height: 450px;
            min-width: 200px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: #252525;
            border-radius: 10px;
            overflow: hidden;
        }

        .product-image {
            width: 100%;
            height: 250px;
            background: #B73738;
            position: relative;
            overflow: hidden;
        }
    }
  </style>

