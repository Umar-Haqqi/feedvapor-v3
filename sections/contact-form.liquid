    </div>

    <div class="contact-with-us-block" style="">
      <h3 style="font-family: ArupalaGrotesk-SuperBold !important; color: #fff;">CONNECT WITH US</h3>
      <div class="contact-details-info">
        <i style="color: #fff; font-size: 24px;" class="ri-tiktok-fill"></i>
        <i style="color: #fff; font-size: 24px;" class="ri-instagram-line"></i>
      </div>
