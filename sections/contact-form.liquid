</div>

<style>
  #ContactForm .field {
    margin-bottom: 20px;
  }
  #ContactForm .field__label {
    color: #fff;
  }
  #ContactForm .field__input {
    background: transparent;
    border: none;
    border-bottom: 1px solid #fff;
    border-radius: 0;
    box-shadow: none;
    color: #fff;
  }
  #ContactForm .field__input:focus {
    border-bottom: 1px solid #fff;
    box-shadow: none;
  }
  #ContactForm .contact-page-submit-btn {
    margin-top: 10px;
  }
  #ContactForm .form-status {
    margin-bottom: 20px;
    color: #fff;
  }
  .phone-number {
    color: white !important;
    pointer-events: none;
    user-select: all;
    text-decoration: none; /* Reset any default link styling */
}
  .contact-with-us-block{
    display: none;
  }
  .contact-page-submit-btn{
    padding: 0 50px;
    color: #fff;
    background: #000;
    border: 1px solid #fff;
    border-radius: 20px;
    padding: 10px 60px;
    position: absolute;
    right: 0;
    font-family: HelveticaNeue_reg;
    cursor:pointer;
  }
  .contact-details-info{
          display: flex;
          justify-content: center;
          align-items: baseline;
          gap: 10px;
          margin-top: 10px;
  }
  .contact-details-info>p{
    font-family: HelveticaNeue_reg;
    font-size: 12px;
    color: #fff !important;
  }
  .contact-details-info-second{
        padding-left: 25px;
    }

  @media screen and (max-width: 500px) {
    .contact-with-us-block{
        display: block;
    }
    .contact-page-submit-btn{
        width: 100%;
    }
    .contact-details-info-second{
        padding-left: 0;
    }
    .feed-contact-details {
        justify-content: flex-start;
        flex-direction: column;
        margin-bottom: 50px;
    }
    .contact-details-info {
        display: flex;
        justify-content: flex-start;
        align-items: baseline;
        gap: 10px;
        margin-top: 10px;
        margin-bottom: 40px;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
