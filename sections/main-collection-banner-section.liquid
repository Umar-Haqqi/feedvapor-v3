{% if template.name == 'collection' and collection %}
  {% assign matched_block = null %}

  {%- for block in section.blocks -%}
    {%- if block.settings.collection == blank -%}
      {%- if matched_block == null -%}
        {% assign matched_block = block %}
      {%- endif -%}
    {%- elsif block.settings.collection.id == collection.id -%}
      {% assign matched_block = block %}
      {% break %}
    {%- endif -%}
  {%- endfor -%}

  {% assign has_banner_image = false %}
  {% if matched_block %}
    {% if matched_block.settings.desktop_image or matched_block.settings.mobile_image %}
      {% assign has_banner_image = true %}
    {% endif %}
  {% endif %}

  {% if has_banner_image %}
    <div class="banner-div">
      {% if matched_block.settings.desktop_image %}
        <img
          class="banner-div-img web-coll-banner-image"
          src="{{ matched_block.settings.desktop_image | image_url: width: 2000 }}"
          alt="Desktop collection banner"
          width="auto"
          height="auto"
        >
      {% endif %}

      {% if matched_block.settings.mobile_image %}
        <img
          class="banner-div-img mob-coll-banner-image"
          src="{{ matched_block.settings.mobile_image | image_url: width: 1200 }}"
          alt="Mobile collection banner"
          width="auto"
          height="auto"
        >
      {% endif %}

      {% if section.settings.overlay_image %}
        <img
          class="banner-div-text"
          src="{{ section.settings.overlay_image | image_url: width: 1200 }}"
          alt="Banner overlay text"
          width="auto"
          height="auto"
        >
      {% endif %}
    </div>
  {% endif %}
{% endif %}

<style>
  .banner-div{
      width: 100%;
      display: grid;
      overflow: hidden;
  }
  .banner-div > img{
      grid-column: 1;
      grid-row: 1;
  }
  .banner-div img.banner-div-img{
      display: block;
      width: 100%;
      height: auto;
      filter: brightness(0.8);
  }

  .banner-div .banner-div-text{
      width: 100%;
      height: 50%;
      object-fit: contain;
      align-self: center;
      justify-self: center;
  }

    /* Default: Desktop */
    .web-coll-banner-image {
        display: block;
    }

    .mob-coll-banner-image {
        display: none;
    }

    /* Mobile screens */
    @media (max-width: 500px) {
        .web-coll-banner-image {
            display: none;
        }

        .mob-coll-banner-image {
            display: block;
        }
    }
</style>

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "overlay_image",
      "label": "Overlay Text Image (shown on all banners)"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Banner Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Banner Image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Attach to Collection (optional)",
          "info": "Leave empty to show on all collections"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Collection Banner",
      "category": "Collection"
    }
  ]
}
{% endschema %}
