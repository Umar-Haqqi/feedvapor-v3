<div class="login-screen">
        <div class="login-container">
            <div class="feed-logo">
                <img src="https://cdn.shopify.com/s/files/1/0860/7183/6978/files/White_Logo-01_wex_6e9c1644-4631-41f9-9b7c-ed81b92645e2.png?v=1708944924"
                    alt="feedlogo">
            </div>
            <h2>LOGIN</h2>
            <div class="input-div">
                <label class="input-label" for="">E-MAIL/USERNAME</label>
                <input type="text" class="input-field" placeholder="E-MAIL/USERNAME">
            </div>
            <div class="input-div">
                <label class="input-label" for="">PASSWORD</label>
                <input class="input-field" type="password" placeholder="PASSWORD">
            </div>
            <button class="login-btn">LOGIN</button>
            <a href="#" class="register-link">DON'T HAVE A ACCOUNT? CREATE ACCOUNT HERE</a>
        </div>
</div>

<style>
  .login-screen {
    width: 100%;
    height: 100vh;
    background-color: #000;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;

}

.login-screen>.login-container {
    width: 20%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 1rem;
}

.login-container>.feed-logo>img {
    width: 150px;
    height: 150px;
    object-fit: contain;
    object-position: center;
}

.login-container>h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.login-container>.input-div {
    width: 100%;
    display: flex;
    flex-direction: column;
}

.login-container>.input-div>.input-label {
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
    color: #dddddd;
}

.login-container>.input-div>.input-field {
    font-size: 0.6rem;
    color: #dddddd;
    background: transparent;
    border: none;
    border-bottom: 1px solid #dddddd;
    width: 100%;
    padding: 0.4rem 0;
}
.login-container>.login-btn {
    width: 100%;
    background: transparent;
    color: #fff;
    border: 1px solid #fff;
    border-radius: 20px;
    padding: 10px;
    margin-top: 1rem;
}
.login-container>.register-link {
    color: #dddddd;
    text-decoration: none;
    font-size: 0.6rem;
}

</style>


{% schema %}
{
  "name": "loginScreen",
  "settings": [],
  "presets":[
    {
      "name": "loginScreen"
    }
  ]
}
{% endschema %}